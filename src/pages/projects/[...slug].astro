---
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DraftTag from "../../components/DraftTag.astro";
import PrevNext from "../../components/PrevNext.astro";
import ProjectMeta from "../../components/ProjectMeta.astro";
import { getProjects, type Project } from "../../lib/content";

export const getStaticPaths = (async () => {
  // Same order as /projects; prev/next wrap around.
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects.at(i - 1),
      next: projects[(i + 1) % projects.length],
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}

const { project, prev, next } = Astro.props;
const { title, summary, cover, draft } = project.data;
const { Content } = await render(project);
// A single project would link to itself.
const hasSiblings = prev && next && prev.id !== project.id;
---

<BaseLayout title={title} description={summary}>
  <article class="pt-16 sm:pt-24">
    <a
      href="/projects"
      class="text-sm text-muted no-underline transition-colors duration-(--dur-fast) ease-out hover:text-text"
    >
      ← Work
    </a>

    <h1 transition:name={`title-${project.id}`} class="mt-12 text-display">
      {title}
    </h1>
    {draft && <DraftTag class="mt-4" />}
    <p class="mt-4 text-lg text-muted">{summary}</p>

    <ProjectMeta class="mt-10" project={project} />

    <Image
      src={cover}
      alt={`${title} cover`}
      widths={[640, 1280]}
      sizes="(min-width: 40rem) 40rem, 100vw"
      loading="eager"
      fetchpriority="high"
      transition:name={`cover-${project.id}`}
      class="my-12 aspect-16/10 w-full object-cover"
    />

    <div class="prose">
      <Content />
    </div>

    {hasSiblings && <PrevNext class="mt-16" prev={prev} next={next} />}
  </article>
</BaseLayout>
