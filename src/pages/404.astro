---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="This page doesn't exist. It may have moved during the redesign."
  noindex
>
  <div class="pt-16 sm:pt-24">
    <p class="meta text-muted">404</p>
    <h1 class="mt-4 text-display">This page doesn't exist.</h1>
    <p class="mt-4 text-lg text-muted">It may have moved during the redesign.</p>
    <p class="mt-12">
      <a href="/">← Back home</a>
    </p>
  </div>
</BaseLayout>
