---
/**
 * Page shell shared by every page: head (SEO, theme, fonts, ClientRouter),
 * skip link, header, main#content and footer, in one 640px column.
 */
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import FontPreload from "../components/FontPreload.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SEO, { type Props as SEOProps } from "../components/SEO.astro";
import SkipLink from "../components/SkipLink.astro";
import ThemeScript from "../components/ThemeScript.astro";
import { site } from "../data/site";

export type Props = SEOProps;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <FontPreload />
    <SEO {...Astro.props} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} · Notes`}
      href={new URL("/rss.xml", Astro.site)}
    />
    <ClientRouter />
  </head>
  <body>
    <SkipLink />
    <div class="mx-auto max-w-column px-6 sm:px-8">
      <Header />
      <main id="content" tabindex="-1" class="focus:outline-none">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<script>
  // The home entrance animation is for first loads only: drop it from swapped-in pages.
  document.addEventListener("astro:before-swap", ({ newDocument }) => {
    newDocument.querySelector("[data-entrance]")?.removeAttribute("data-entrance");
  });
</script>
