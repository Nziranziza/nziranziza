---
/**
 * Writing row: title and published date, linking to the note.
 * `short` drops the year (`Nov 2`) for lists grouped by year (/notes, #11).
 */
import { formatDate, formatShortDate, type Note } from "../lib/content";

export interface Props {
  note: Note;
  short?: boolean;
}

const { note, short = false } = Astro.props;
const { title, published } = note.data;
---

<li>
  <a href={`/notes/${note.id}`} class="group list-row flex items-baseline justify-between gap-4">
    <span class="truncate underline decoration-transparent underline-offset-4 transition-[text-decoration-color] duration-(--dur-fast) ease-out group-hover:decoration-accent group-focus-visible:decoration-accent">
      {title}
    </span>
    <time datetime={published.toISOString()} class="meta shrink-0 text-muted">
      {short ? formatShortDate(published) : formatDate(published)}
    </time>
  </a>
</li>
