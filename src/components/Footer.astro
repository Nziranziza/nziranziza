---
/**
 * Site footer: copyright, live Kigali clock, source and RSS links.
 * Persisted across ClientRouter swaps so the clock keeps ticking.
 */
import { site } from "../data/site";
import LocalTime from "./LocalTime.astro";

const year = new Date().getFullYear();
---

<footer
  transition:persist="footer"
  class="meta mt-24 flex flex-col gap-2 border-t border-border pt-6 pb-12 text-muted sm:flex-row sm:justify-between"
>
  <p>
    © {year} {site.name}
  </p>
  {/* Flex gap instead of whitespace, which HTML compression strips. */}
  <p class="flex flex-wrap items-center gap-2">
    <span>
      {site.location.city} <LocalTime />
    </span>
    <span class="text-subtle" aria-hidden="true">
      ·
    </span>
    <a href={site.source} target="_blank" rel="noopener">
      Source<span class="sr-only"> (opens in a new tab)</span>
    </a>
    <span class="text-subtle" aria-hidden="true">
      ·
    </span>
    <a href="/rss.xml">RSS</a>
  </p>
</footer>
