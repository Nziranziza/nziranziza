---
/**
 * Email link plus a copy button. The button stays hidden without JS or the
 * Clipboard API; on copy it shows a check for 1.5s and announces "Email copied".
 */
import { site } from "../data/site";
import Check from "../icons/check.svg";
import Copy from "../icons/copy.svg";
---

<p class="flex items-center gap-2">
  <a href={`mailto:${site.email}`}>{site.email}</a>
  <button
    type="button"
    hidden
    data-copy-email={site.email}
    aria-label="Copy email"
    class="group inline-flex size-6 cursor-pointer items-center justify-center rounded-sm text-muted transition-colors duration-(--dur-fast) ease-out hover:text-text"
  >
    <Copy class="group-data-copied:hidden" />
    <Check class="hidden group-data-copied:block" />
  </button>
  <span role="status" aria-live="polite" class="sr-only" data-copy-status></span>
</p>

<script>
  const COPIED_MS = 1500;
  let reset: ReturnType<typeof setTimeout> | undefined;

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLButtonElement>("[data-copy-email]").forEach((button) => {
      button.hidden = !navigator.clipboard;
    });
  });

  // Delegated, so it keeps working after ClientRouter swaps.
  document.addEventListener("click", async (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>("[data-copy-email]");
    if (!button) return;

    try {
      await navigator.clipboard.writeText(button.dataset.copyEmail ?? "");
    } catch {
      return; // Permission denied: the mailto link still works.
    }

    const status = button.parentElement?.querySelector("[data-copy-status]");
    button.dataset.copied = "";
    if (status) status.textContent = "Email copied";
    // A repeat click restarts the 1.5s instead of being cut short by the first timer.
    clearTimeout(reset);
    reset = setTimeout(() => {
      delete button.dataset.copied;
      if (status) status.textContent = "";
    }, COPIED_MS);
  });
</script>
